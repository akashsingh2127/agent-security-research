# ==============================================================================
# Environment Configuration Template (Synthetic / Local Development Only)
# ==============================================================================
# WARNING: Do NOT place real secrets or credentials in this file or any .env file.
# This project uses synthetic application data and local LLM execution.
# ==============================================================================

# Target Application Configuration
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./synthetic_data.db

# Target LLM / Agent Configuration (Local Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Provisional model choice; subject to empirical validation in future milestones
TARGET_MODEL_NAME=qwen2.5:3b-instruct

# Security Evaluation Engine Configuration
EVAL_LOG_LEVEL=INFO
EVAL_ARTIFACTS_DIR=./experiments/runs
PROMPTFOO_CONFIG_PATH=./baselines/promptfoo/promptfooconfig.yaml

